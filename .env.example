# Copy this file to .env.local and fill in real values for local development.
# On Vercel, set these as real project environment variables — see
# Project Settings → Environment Variables.

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (preferred) or anon key. All authorization happens in
# this app's server actions, not in Postgres RLS — see supabase/schema.sql —
# so this key effectively has full access to every av_* table. Treat it as
# a secret, never expose it to the client, and rotate it if it's ever
# committed or logged.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Random secret used to HMAC-sign the login session cookie. Generate one
# with, e.g., `openssl rand -hex 32`. Changing this invalidates every
# existing session (forces re-login), which is expected and safe.
SESSION_SECRET=
